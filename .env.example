# Copy this file to .env.local (development) or .env.prod (production)
# and fill in real values. Never commit the resulting file.

NODE_ENV=development
PORT=3940

# Required. In production there is no fallback — the app refuses to boot without it.
MONGO_URI=mongodb://localhost:27017/lupulos_local

# Required secrets — the app throws at boot if any of these are missing.
JWT_SECRET=change_me_access_secret
REFRESH_SECRET=change_me_refresh_secret
SESSION_SECRET=change_me_session_secret

JWT_EXPIRATION=2h
REFRESH_EXPIRATION=7d

FRONTEND_URL=http://localhost:3000
# CSV of extra allowed CORS origins, added on top of FRONTEND_URL and localhost:3000.
CORS_ORIGINS=

TRUST_PROXY=false
BODY_LIMIT=1mb
URLENCODED_LIMIT=1mb

# Google OAuth (optional — login with Google is disabled until both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3940/api/auth/google/callback

# Mercado Pago (optional — required to accept real subscriptions)
MERCADOPAGO_ACCESS_TOKEN=
# Required in production if Mercado Pago is enabled: webhook calls without a
# valid signature are rejected when NODE_ENV=production.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BACK_URL=http://localhost:3000/planes

# HTTPS (optional — only used if certs/key.pem and certs/cert.pem exist)
FORCE_HTTPS=false
FORCE_HTTP=false
